				class="index-list line-frame"
				aria-label="Primary sections"
				data-reactive-frame
				data-frame-variant="register"
			>
				<span class="reactive-frame-lines" aria-hidden="true">
					<i class="frame-line frame-line--top" data-frame-line="top"></i>
					<i class="frame-line frame-line--right" data-frame-line="right"></i>
					<i class="frame-line frame-line--bottom" data-frame-line="bottom"></i>
