							<button type="button" data-dossier-prev aria-label="Previous CV section">←</button>
							<button type="button" data-dossier-next aria-label="Next CV section">→</button>
						</div>
					</div>
					<div
						class="dossier-viewport"
						data-dossier-viewport
						tabindex="0"
						aria-label="CV summary. Drag horizontally or use the left and right arrow keys."
					>
						<div class="dossier-track">
							<section class="dossier-card">
								<p class="dossier-index">01 / Education</p>
								<div class="dossier-entry">
									<h3>M.A. in Interactive Media Arts (IMA)</h3>
									<p>New York University</p>
									<p class="dossier-meta">2021–2022</p>
								</div>
								<div class="dossier-entry">
									<h3>B.A. in New Technologies of Art</h3>
									<p>Accademia Albertina di Belle Arti di Torino</p>
									<p class="dossier-meta">2014–2017</p>
								</div>
							</section>

							<section class="dossier-card">
								<p class="dossier-index">02 / Academic positions & employment</p>
								<div class="dossier-entry">
									<h3>Lecturer in Digital Media Technology</h3>
									<p class="dossier-meta">
										Chongqing College of International Business and Economics / 2022–2025
									</p>
									<p>
										Designed and delivered Interactive Technology and Virtual Reality courses;
										established the college’s first Digital Media Studio; supervised project work and
										undergraduate theses.
									</p>
								</div>
								<div class="dossier-entry dossier-entry--compact">
									<h3>Executive Director</h3>
									<p class="dossier-meta">Xu Beihong Art Museum / 2020–2021</p>
								</div>
								<div class="dossier-entry dossier-entry--compact">
									<h3>Multimedia Designer</h3>
									<p class="dossier-meta">
										Chongqing Daoshi Cultural Consulting Co., Ltd. / 2017–2019
									</p>
								</div>
							</section>

							<section class="dossier-card">
								<p class="dossier-index">03 / Publication & exhibitions</p>
								<div class="dossier-entry">
									<h3>
										Design and Implementation of a Unity-Based Experimental Walking Simulation with
										Dialogue-Driven Interaction and Looping Scene Control
									</h3>
									<p class="dossier-meta">
										Ma, H. / Computing, Performance and Communication Systems / Issue 1 / 2026 /
										accepted for publication
