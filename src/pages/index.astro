					view cv profile / education
				</button>
			</div>
		</section>

		<section class="register-grid" aria-labelledby="direction-title">
			<div class="section-mark">
				<span>02</span>
				<h2 id="direction-title">Research and Artistic Direction</h2>
			</div>
			<div
				class="direction-copy line-frame"
				data-reactive-frame
				data-frame-variant="direction"
			>
				<span class="reactive-frame-lines" aria-hidden="true">
					<i class="frame-line frame-line--top" data-frame-line="top"></i>
					<i class="frame-line frame-line--right" data-frame-line="right"></i>
					<i class="frame-line frame-line--bottom" data-frame-line="bottom"></i>
