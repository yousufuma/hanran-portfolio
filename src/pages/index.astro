</Layout>

<script>
	const registerEntryLinks = document.querySelectorAll('.index-list a');
	const identityTitle = document.querySelector('[data-identity-title]');
	const identityToggle = document.querySelector('[data-identity-toggle]');
	const identityStatementPanel = document.querySelector('[data-identity-panel="statement"]');
	const identityEducationPanel = document.querySelector('[data-identity-panel="education"]');

	for (const link of registerEntryLinks) {
		const activate = () => link.classList.add('is-expanded');
		const deactivate = () => link.classList.remove('is-expanded');

		link.addEventListener('mouseenter', activate);
		link.addEventListener('mouseleave', deactivate);
		link.addEventListener('focus', activate);
		link.addEventListener('blur', deactivate);
	}

	if (identityToggle && identityStatementPanel && identityEducationPanel && identityTitle) {
		identityToggle.addEventListener('click', () => {
			const showEducation = identityEducationPanel.hasAttribute('hidden');

			identityStatementPanel.toggleAttribute('hidden', showEducation);
			identityEducationPanel.toggleAttribute('hidden', !showEducation);
			identityToggle.setAttribute('aria-expanded', String(showEducation));
			identityToggle.textContent = showEducation
				? 'back to identity statement'
				: 'view cv profile / education';
			identityTitle.textContent = showEducation ? 'CV Profile' : 'Identity Statement';
			if (showEducation) {
				requestAnimationFrame(() => dossierViewport?.dispatchEvent(new Event('scroll')));
			}
		});
	}

	const dossierViewport = document.querySelector<HTMLElement>('[data-dossier-viewport]');
	const dossierPrev = document.querySelector<HTMLButtonElement>('[data-dossier-prev]');
	const dossierNext = document.querySelector<HTMLButtonElement>('[data-dossier-next]');

	if (dossierViewport && dossierPrev && dossierNext) {
		let pointerStart = 0;
		let scrollStart = 0;
		let dragging = false;

		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const scrollByPanel = (direction: number) => {
			dossierViewport.scrollBy({
				left: direction * dossierViewport.clientWidth * 0.82,
				behavior: prefersReducedMotion.matches ? 'auto' : 'smooth',
			});
		};

		const updateDossierControls = () => {
			const maxScroll = dossierViewport.scrollWidth - dossierViewport.clientWidth;
			dossierPrev.disabled = dossierViewport.scrollLeft <= 2;
			dossierNext.disabled = dossierViewport.scrollLeft >= maxScroll - 2;
		};

		dossierPrev.addEventListener('click', () => scrollByPanel(-1));
		dossierNext.addEventListener('click', () => scrollByPanel(1));

		dossierViewport.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
				event.preventDefault();
				scrollByPanel(event.key === 'ArrowLeft' ? -1 : 1);
			}
		});

		dossierViewport.addEventListener('pointerdown', (event) => {
			if (event.pointerType === 'touch' || event.button !== 0) return;
			dragging = true;
			pointerStart = event.clientX;
			scrollStart = dossierViewport.scrollLeft;
			dossierViewport.classList.add('is-dragging');
			dossierViewport.setPointerCapture(event.pointerId);
		});

		dossierViewport.addEventListener('pointermove', (event) => {
			if (!dragging) return;
			dossierViewport.scrollLeft = scrollStart - (event.clientX - pointerStart);
		});

		const stopDragging = (event: PointerEvent) => {
			if (!dragging) return;
			dragging = false;
			dossierViewport.classList.remove('is-dragging');
			if (dossierViewport.hasPointerCapture(event.pointerId)) {
				dossierViewport.releasePointerCapture(event.pointerId);
			}
		};

		dossierViewport.addEventListener('pointerup', stopDragging);
		dossierViewport.addEventListener('pointercancel', stopDragging);
		dossierViewport.addEventListener('scroll', updateDossierControls, { passive: true });
		window.addEventListener('resize', updateDossierControls);
		updateDossierControls();
	}

	const reactiveFrames = document.querySelectorAll<HTMLElement>('[data-reactive-frame]');
	const reduceFrameMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const finePointer = window.matchMedia('(pointer: fine)');
	const clamp = (value: number, minimum: number, maximum: number) =>
		Math.min(maximum, Math.max(minimum, value));
	const randomBetween = (minimum: number, maximum: number) =>
		minimum + Math.random() * (maximum - minimum);

	const frameStates = Array.from(reactiveFrames).map((frame, frameIndex) => {
		const horizontalLines = (['top', 'bottom'] as const)
			.map((edge) => {
				const element = frame.querySelector<HTMLElement>(`[data-frame-line="${edge}"]`);
				if (!element) return null;

				const baseScale = randomBetween(0.91, 0.995);
				element.style.setProperty('--line-thickness', `${randomBetween(0.8, 1.45).toFixed(2)}px`);
				element.style.transformOrigin = Math.random() > 0.5 ? 'left center' : 'right center';
				element.style.transform = `translate3d(0, 0, 0) scaleX(${baseScale})`;

				return { edge, element, y: 0, scale: baseScale, baseScale };
			})
			.filter((line): line is NonNullable<typeof line> => Boolean(line));

		const verticalFields = (['left', 'right'] as const)
			.map((edge, edgeIndex) => {
				const element = frame.querySelector<HTMLElement>(`[data-frame-line="${edge}"]`);
				if (!element) return null;

				const fieldHeight = Math.max(frame.offsetHeight, 160);
				const unitCount = clamp(Math.round(fieldHeight / 34), 8, 18);
				const units = Array.from({ length: unitCount }, (_, unitIndex) => {
					const unit = document.createElement('span');
					const isDot = (unitIndex + edgeIndex + frameIndex) % 4 === 0 || Math.random() < 0.22;
					const ratio = clamp(
						(unitIndex + randomBetween(0.2, 0.8)) / unitCount,
						0.025,
						0.975,
					);
					const baseWidth = isDot ? randomBetween(1.5, 2.4) : randomBetween(5, 13);

					unit.className = `vertical-unit ${isDot ? 'vertical-unit--dot' : 'vertical-unit--dash'}`;
					unit.style.top = `${(ratio * 100).toFixed(3)}%`;
					unit.style.setProperty('--unit-width', `${baseWidth.toFixed(2)}px`);
					unit.style.setProperty('--unit-thickness', `${randomBetween(0.8, 1.4).toFixed(2)}px`);
					unit.style.opacity = randomBetween(0.55, 0.88).toFixed(2);
					element.append(unit);

					return {
						element: unit,
						ratio,
						isDot,
						phase: randomBetween(0, Math.PI * 2),
						x: 0,
						y: 0,
						scale: 1,
					};
				});

				return { edge, element, units };
			})
			.filter((field): field is NonNullable<typeof field> => Boolean(field));

		return { frame, horizontalLines, verticalFields };
	});

	if (frameStates.length && finePointer.matches && !reduceFrameMotion.matches) {

		let pointerX = -1000;
		let pointerY = -1000;
		let pointerActive = false;
		let animationFrame = 0;

		const scheduleFrameMotion = () => {
			if (!animationFrame) animationFrame = requestAnimationFrame(renderFrameMotion);
		};

		const renderFrameMotion = () => {
			animationFrame = 0;
			let stillMoving = false;

			for (const state of frameStates) {
				const rect = state.frame.getBoundingClientRect();

				for (const line of state.horizontalLines) {
					let targetY = 0;
					let targetScale = line.baseScale;

					if (pointerActive) {
						const edgePosition = line.edge === 'top' ? rect.top : rect.bottom;
						const tangentGap =
							pointerX < rect.left
								? rect.left - pointerX
								: pointerX > rect.right
									? pointerX - rect.right
									: 0;
						const signedDistance = pointerY - edgePosition;
						const distance = Math.hypot(signedDistance, tangentGap * 0.8);
						const intensity = clamp(1 - distance / 105, 0, 1) ** 2;
						targetY = (signedDistance >= 0 ? -1 : 1) * 5.5 * intensity;
						targetScale = line.baseScale * (1 - intensity * 0.012);
					}

					line.y += (targetY - line.y) * 0.14;
					line.scale += (targetScale - line.scale) * 0.14;
					stillMoving ||=
						Math.abs(targetY - line.y) > 0.04 ||
						Math.abs(targetScale - line.scale) > 0.001;
					line.element.style.transform = `translate3d(0, ${line.y}px, 0) scaleX(${line.scale})`;
				}

				for (const field of state.verticalFields) {
					const edgeX = field.edge === 'left' ? rect.left : rect.right;
					const horizontalDistance = Math.abs(pointerX - edgeX);
					const fieldIntensity = pointerActive
						? clamp(1 - horizontalDistance / 82, 0, 1) ** 2
						: 0;
					const outwardDirection = field.edge === 'left' ? -1 : 1;

					for (const unit of field.units) {
						const unitY = rect.top + rect.height * unit.ratio;
						const verticalDistance = Math.abs(pointerY - unitY);
						const localIntensity =
							fieldIntensity * clamp(1 - verticalDistance / 86, 0, 1) ** 2;
						const targetX =
							outwardDirection * (1.4 + Math.abs(Math.sin(unit.phase)) * 4.2) * localIntensity;
						const targetY = Math.sin(unit.phase * 1.7) * 4.5 * localIntensity;
						const targetScale = unit.isDot
							? 1 + localIntensity * 0.45
							: 1 + Math.cos(unit.phase) * 0.32 * localIntensity;

						unit.x += (targetX - unit.x) * 0.16;
						unit.y += (targetY - unit.y) * 0.16;
						unit.scale += (targetScale - unit.scale) * 0.16;
						stillMoving ||=
							Math.abs(targetX - unit.x) > 0.03 ||
							Math.abs(targetY - unit.y) > 0.03 ||
							Math.abs(targetScale - unit.scale) > 0.002;
						unit.element.style.transform = `translate3d(${unit.x}px, calc(-50% + ${unit.y}px), 0) scaleX(${unit.scale})`;
					}
				}
			}

			if (stillMoving) scheduleFrameMotion();
		};

		window.addEventListener(
			'pointermove',
			(event) => {
				if (event.pointerType === 'touch') return;
				pointerX = event.clientX;
				pointerY = event.clientY;
				pointerActive = true;
				scheduleFrameMotion();
			},
			{ passive: true },
		);

		const resetFrameMotion = () => {
			pointerActive = false;
			scheduleFrameMotion();
		};

		document.documentElement.addEventListener('mouseleave', resetFrameMotion);
		window.addEventListener('blur', resetFrameMotion);
	}
</script>

<style>
	:global(body) {
		background: #f5f1e8;
	}

	.register-shell {
		--field: #f5f1e8;
		--ink-local: #10100d;
		--faint: #5f5a51;
		--line: #10100d;
