								</div>
								<ul class="dossier-list">
									<li><span>Result Fairy</span><small>NYU Art Gallery, New York / 2021</small></li>
									<li>
										<span>Temporary Radio: Children Do Not Lie</span
										><small>Yuan Art Museum, Chongqing / 2021</small>
									</li>
									<li><span>Taixu huanjing</span><small>Kumamoto Museum of Art, Japan / 2022</small></li>
								</ul>
							</section>

							<section class="dossier-card">
								<p class="dossier-index">04 / Selected research & artistic projects</p>
								<ul class="dossier-list dossier-list--projects">
									<li>
										<span>Game Engines as Technical Platforms for Hybrid Interactive Art</span
										><small>PhD research direction / 2026</small>
									</li>
									<li>
										<span>On the Other Side of the Wall</span
										><small>Experimental walking simulation / Unity</small>
									</li>
									<li>
										<span>Something Big Is Coming</span
										><small>Interactive narrative system / 2025</small>
									</li>
									<li>
										<span>Interactive Design for Deaf and Hard-of-Hearing Audiences</span
										><small>Unity + external devices / 2024–2025</small>
									</li>
									<li>
										<span>Children’s System: Eggs Eggs Eggs</span
										><small>Multimedia art education project / 2020</small>
									</li>
								</ul>
							</section>

							<section class="dossier-card">
								<p class="dossier-index">05 / Methods, tools & certification</p>
								<ul class="keyword-cloud" aria-label="Research keywords">
									<li>Unity-based hybrid interactive art</li>
									<li>State-machine narrative</li>
									<li>Realtime visual orchestration</li>
									<li>Generative media pipelines</li>
									<li>Structural legibility</li>
									<li>Research-through-design</li>
								</ul>
								<div class="dossier-entry dossier-entry--compact">
									<h3>Tools</h3>
									<p>
										Unity / TouchDesigner / Processing / Blender / vvvv Gamma / Arduino / sensors /
										realtime media workflows
									</p>
								</div>
								<div class="dossier-entry dossier-entry--compact">
									<h3>Certification</h3>
									<p>Unity Certified Educator / Member, China Computer Graphics Society</p>
								</div>
							</section>
						</div>
					</div>
				</div>
				<button
					class="identity-toggle"
					type="button"
					data-identity-toggle
					aria-controls="identity-content"
					aria-expanded="false"
				>
					view cv profile / education
				</button>
			</div>
		</section>

		<section class="register-grid" aria-labelledby="direction-title">
			<div class="section-mark">
				<span>02</span>
				<h2 id="direction-title">Research and Artistic Direction</h2>
			</div>
			<div class="direction-copy">
				{directions.map((direction) => <p>{direction}</p>)}
			</div>
		</section>

		<section class="register-grid" aria-labelledby="register-title">
			<div class="section-mark">
				<span>03</span>
				<h2 id="register-title">Register Entries</h2>
			</div>
			<nav class="index-list" aria-label="Primary sections">
				{
					navigation.map((item, index) => (
						<a href={item.href} target={item.target} rel={item.rel} data-state="pending">
							<span class="index-number">{String(index + 1).padStart(2, '0')}</span>
							<span class="index-title">/{item.title}</span>
							<span class="index-code">{item.code}</span>
							<span class="index-meta">{item.meta}</span>
						</a>
					))
				}
			</nav>
		</section>

		<footer class="register-grid contact-grid" aria-labelledby="contact-title">
			<div class="section-mark">
				<span>04</span>
				<h2 id="contact-title">Contact</h2>
			</div>
			<div class="contact-line">
				<div class="contact-primary">
					<a class="contact-email" href="mailto:youcometwice@gmail.com">youcometwice@gmail.com</a>
					<a class="contact-phone" href="tel:+8618323072776">+86 183 2307 2776</a>
				</div>
				<a class="cv-download" href="/cv/HanranMa_CV.pdf" download>
					download cv
				</a>
			</div>
		</footer>
	</main>
</Layout>

<script>
	const registerEntryLinks = document.querySelectorAll('.index-list a');
	const identityTitle = document.querySelector('[data-identity-title]');
	const identityToggle = document.querySelector('[data-identity-toggle]');
	const identityStatementPanel = document.querySelector('[data-identity-panel="statement"]');
	const identityEducationPanel = document.querySelector('[data-identity-panel="education"]');

	for (const link of registerEntryLinks) {
		const activate = () => link.classList.add('is-expanded');
		const deactivate = () => link.classList.remove('is-expanded');

		link.addEventListener('mouseenter', activate);
		link.addEventListener('mouseleave', deactivate);
		link.addEventListener('focus', activate);
		link.addEventListener('blur', deactivate);
	}

	if (identityToggle && identityStatementPanel && identityEducationPanel && identityTitle) {
		identityToggle.addEventListener('click', () => {
			const showEducation = identityEducationPanel.hasAttribute('hidden');

			identityStatementPanel.toggleAttribute('hidden', showEducation);
			identityEducationPanel.toggleAttribute('hidden', !showEducation);
			identityToggle.setAttribute('aria-expanded', String(showEducation));
			identityToggle.textContent = showEducation
				? 'back to identity statement'
				: 'view cv profile / education';
			identityTitle.textContent = showEducation ? 'CV Profile' : 'Identity Statement';
			if (showEducation) {
				requestAnimationFrame(() => dossierViewport?.dispatchEvent(new Event('scroll')));
			}
		});
	}

	const dossierViewport = document.querySelector<HTMLElement>('[data-dossier-viewport]');
	const dossierPrev = document.querySelector<HTMLButtonElement>('[data-dossier-prev]');
	const dossierNext = document.querySelector<HTMLButtonElement>('[data-dossier-next]');

	if (dossierViewport && dossierPrev && dossierNext) {
		let pointerStart = 0;
		let scrollStart = 0;
		let dragging = false;

		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const scrollByPanel = (direction: number) => {
			dossierViewport.scrollBy({
				left: direction * dossierViewport.clientWidth * 0.82,
				behavior: prefersReducedMotion.matches ? 'auto' : 'smooth',
			});
		};

		const updateDossierControls = () => {
			const maxScroll = dossierViewport.scrollWidth - dossierViewport.clientWidth;
			dossierPrev.disabled = dossierViewport.scrollLeft <= 2;
			dossierNext.disabled = dossierViewport.scrollLeft >= maxScroll - 2;
		};

		dossierPrev.addEventListener('click', () => scrollByPanel(-1));
		dossierNext.addEventListener('click', () => scrollByPanel(1));

		dossierViewport.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
				event.preventDefault();
				scrollByPanel(event.key === 'ArrowLeft' ? -1 : 1);
			}
		});

		dossierViewport.addEventListener('pointerdown', (event) => {
			if (event.pointerType === 'touch' || event.button !== 0) return;
			dragging = true;
			pointerStart = event.clientX;
			scrollStart = dossierViewport.scrollLeft;
			dossierViewport.classList.add('is-dragging');
			dossierViewport.setPointerCapture(event.pointerId);
		});

		dossierViewport.addEventListener('pointermove', (event) => {
			if (!dragging) return;
			dossierViewport.scrollLeft = scrollStart - (event.clientX - pointerStart);
		});

		const stopDragging = (event: PointerEvent) => {
			if (!dragging) return;
			dragging = false;
			dossierViewport.classList.remove('is-dragging');
			if (dossierViewport.hasPointerCapture(event.pointerId)) {
				dossierViewport.releasePointerCapture(event.pointerId);
			}
		};

		dossierViewport.addEventListener('pointerup', stopDragging);
		dossierViewport.addEventListener('pointercancel', stopDragging);
		dossierViewport.addEventListener('scroll', updateDossierControls, { passive: true });
		window.addEventListener('resize', updateDossierControls);
		updateDossierControls();
	}
</script>

<style>
	:global(body) {
		background: #f5f1e8;
	}

	.register-shell {
		--field: #f5f1e8;
		--ink-local: #10100d;
		--faint: #5f5a51;
		--line: #10100d;
		--line-dark: #10100d;
		--link: #143d31;
		width: min(1120px, calc(100% - 32px));
		min-height: 100vh;
		margin: 0 auto;
		padding: 34px 0 72px;
		color: var(--ink-local);
	}

	.hero-grid,
	.register-grid {
		display: grid;
		grid-template-columns: 86px minmax(0, 1fr);
		column-gap: 28px;
	}

	.margin-note,
	.section-mark,
	.index-number,
	.index-code,
	.index-meta,
	.cv-download {
		font-family: var(--font-mono);
		font-size: 10px;
		line-height: 1.35;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	p,
	h1,
	h2,
	h3,
	dl {
		margin: 0;
	}

	.hero-grid {
		min-height: 46vh;
		padding: 18px 0 52px;
		border-top: 2px solid var(--line-dark);
		border-bottom: 1px solid var(--line-dark);
	}

	.margin-note {
		display: grid;
		align-content: start;
		gap: 18px;
		color: var(--faint);
	}

	.name-block {
		display: grid;
		align-content: end;
		padding-top: 12vh;
	}

	.identity-card {
		width: min(760px, 100%);
		border-top: 3px solid var(--line-dark);
		border-bottom: 1px solid var(--line-dark);
	}

	.identity-rule {
		display: grid;
		height: 18px;
		border-bottom: 1px solid var(--line);
	}

	.identity-rule span + span {
		border-left: 1px solid var(--line);
	}

	.identity-rule span:nth-child(2) {
		border-left-width: 2px;
	}

	.identity-rule-top {
		grid-template-columns: 2.3fr 0.85fr 1.15fr;
	}

	.identity-rule-bottom {
		grid-template-columns: 0.7fr 1.45fr 2.15fr;
		height: 14px;
		border-top: 1px solid var(--line);
		border-bottom: 0;
	}

	.discipline-line {
		display: flex;
		flex-wrap: wrap;
		gap: 5px 10px;
		width: min(760px, 100%);
		padding-top: 12px;
		color: var(--faint);
		font-family: var(--font-mono);
		font-size: 10px;
		line-height: 1.35;
		letter-spacing: 0.045em;
		text-transform: uppercase;
	}

	.discipline-line i {
		color: var(--ink-local);
		font-style: normal;
	}

	.identity-columns {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		min-height: 168px;
	}

	.identity-column {
		display: grid;
		align-content: center;
		gap: 18px;
		padding: 26px 28px 30px 0;
	}

	.identity-column + .identity-column {
		padding-right: 0;
		padding-left: 28px;
		border-left: 1px solid var(--line);
	}

	.identity-name {
		margin: 0;
		color: var(--ink-local);
		font-size: clamp(18px, 2.3vw, 28px);
		font-weight: 400;
		line-height: 1.08;
		letter-spacing: 0.1em;
	}

	.primary-name {
		font-size: clamp(28px, 4vw, 44px);
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.identity-name.zh {
		font-family: "Songti SC", "Noto Serif CJK TC", "PMingLiU", "SimSun", serif;
		font-size: clamp(21px, 2.7vw, 34px);
		letter-spacing: 0.22em;
	}

	.identity-name.ar {
		direction: rtl;
		font-family: "Noto Naskh Arabic", "Geeza Pro", "Amiri", "Arial", sans-serif;
		font-size: clamp(21px, 2.7vw, 34px);
		letter-spacing: 0.02em;
		text-align: left;
	}

	.register-grid {
		padding: 24px 0 58px;
		border-bottom: 1px solid var(--line);
	}

	.section-mark {
		display: grid;
		align-content: start;
		gap: 18px;
		color: var(--faint);
	}

	.section-mark span {
		color: var(--ink-local);
	}

	h2 {
		max-width: 120px;
		font-size: 10px;
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.statement,
	.direction-copy,
	.index-list,
	.contact-line {
		grid-column: 2;
	}

	.statement {
		display: grid;
		gap: 20px;
		max-width: 760px;
		font-size: clamp(18px, 2vw, 26px);
		line-height: 1.42;
		letter-spacing: 0.035em;
	}

	.identity-panel--statement {
		display: grid;
		gap: 22px;
	}

	.identity-panel[hidden] {
		display: none;
	}

	.cv-dossier {
		display: grid;
		width: min(760px, 100%);
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		font-size: 13px;
		line-height: 1.52;
		letter-spacing: 0.012em;
	}

	.dossier-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 38px;
		padding: 6px 0;
		border-bottom: 1px solid var(--line);
	}

	.dossier-toolbar > p {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 16px;
		color: var(--faint);
	}

	.dossier-toolbar,
	.dossier-index,
	.dossier-meta,
	.dossier-list small,
	.identity-toggle,
	.contact-phone {
		font-family: var(--font-mono);
		font-size: 10px;
		line-height: 1.35;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.dossier-controls {
		display: grid;
		grid-template-columns: repeat(2, 32px);
		border: 1px solid var(--line);
	}

	.dossier-controls button {
		width: 32px;
		height: 25px;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--ink-local);
		font: inherit;
		cursor: pointer;
	}

	.dossier-controls button + button {
		border-left: 1px solid var(--line);
	}

	.dossier-controls button:hover,
	.dossier-controls button:focus-visible {
		background: var(--ink-local);
		color: var(--field);
		outline: none;
	}

	.dossier-controls button:disabled {
		color: #aaa398;
		cursor: default;
	}

	.dossier-controls button:disabled:hover {
		background: transparent;
	}

	.dossier-viewport {
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x proximity;
		scrollbar-width: thin;
		scrollbar-color: var(--ink-local) transparent;
		cursor: grab;
		-webkit-overflow-scrolling: touch;
	}

	.dossier-viewport:focus-visible {
		outline: 1px solid var(--link);
		outline-offset: 4px;
	}

	.dossier-viewport.is-dragging {
		cursor: grabbing;
		user-select: none;
	}

	.dossier-track {
		display: flex;
		align-items: stretch;
		width: max-content;
	}

	.dossier-card {
		display: grid;
		align-content: start;
		gap: 22px;
		width: clamp(280px, 46vw, 390px);
		min-height: 405px;
		padding: 18px 24px 26px 0;
		scroll-snap-align: start;
	}

	.dossier-card + .dossier-card {
		padding-left: 24px;
		border-left: 1px solid var(--line);
	}

	.dossier-index,
	.dossier-meta,
	.dossier-list small {
		color: var(--faint);
		font-weight: 400;
	}

	.dossier-index {
		color: var(--link);
	}

	.dossier-entry {
		display: grid;
		gap: 5px;
	}

	.dossier-entry--compact {
		padding-top: 14px;
		border-top: 1px solid var(--line);
	}

	.dossier-entry h3,
	.dossier-list span {
		font-size: 16px;
		font-weight: 400;
		line-height: 1.28;
		letter-spacing: 0.02em;
	}

	.dossier-list,
	.keyword-cloud {
		display: grid;
		gap: 0;
