					<i class="frame-line frame-line--top" data-frame-line="top"></i>
					<i class="frame-line frame-line--right" data-frame-line="right"></i>
					<i class="frame-line frame-line--bottom" data-frame-line="bottom"></i>
					<i class="frame-line frame-line--left" data-frame-line="left"></i>
				</span>
				<div class="contact-primary">
					<a class="contact-email" href="mailto:youcometwice@gmail.com">youcometwice@gmail.com</a>
					<a class="contact-phone" href="tel:+8618323072776">+86 183 2307 2776</a>
				</div>
				<a class="cv-download" href="/cv/HanranMa_CV.pdf" download>
					download cv
