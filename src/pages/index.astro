---
import Layout from '../layouts/Layout.astro';

const identityGroups = [
	{
		names: [
			{ value: 'Hanran Ma', lang: 'en', primary: true },
			{ value: '馬瀚然', lang: 'zh' },
		],
	},
	{
		names: [
			{ value: 'Yusuf Ma', lang: 'en' },
			{ value: 'يوسف ما', lang: 'ar' },
		],
	},
];

const directions = [
	'My research examines how game engines, especially Unity, can function not only as production tools but as creative and technical infrastructures for hybrid interactive art.',
	'I am interested in how state logic, event-driven interaction, realtime visual feedback, and generative content pipelines shape image, narrative, perception, and audience experience.',
	'My current PhD-facing direction develops a reusable Unity-based framework organised around state-machine narrative, realtime visual orchestration, and generative media pipelines. Across this work, technical structure becomes a visible part of artistic expression.',
];

const soundCloudUrl =
	'https://soundcloud.com/ttfdpkmc0ssc?utm_source=clipboard&utm_medium=text&utm_campaign=social_sharing';

const navigation = [
	{
		href: '/works',
		title: 'works',
		code: 'image systems',
		meta: 'states / frames / visual engines',
	},
	{
		href: '/research',
		title: 'research',
		code: 'technical grammar',
		meta: 'papers / notes / methods',
	},
	{
		href: '/practice',
		title: 'practice',
		code: 'practice & pedagogy',
		meta: 'personal projects / collaborations / student Unity works',
	},
	{
		href: soundCloudUrl,
		title: 'sound',
		code: 'frequencies',
		meta: 'underground / rhythm / listening',
		target: '_blank',
		rel: 'noopener noreferrer',
	},
];
---

<Layout>
	<main class="register-shell" aria-labelledby="site-title">
		<section class="hero-grid">
			<aside class="margin-note" aria-label="Index metadata">
				<span>00</span>
				<span>Index</span>
			</aside>

			<div class="name-block">
				<section
					class="identity-card line-frame"
					aria-label="Artist identity card"
					data-reactive-frame
					data-frame-variant="hero"
				>
					<span class="reactive-frame-lines" aria-hidden="true">
						<i class="frame-line frame-line--top" data-frame-line="top"></i>
						<i class="frame-line frame-line--right" data-frame-line="right"></i>
						<i class="frame-line frame-line--bottom" data-frame-line="bottom"></i>
						<i class="frame-line frame-line--left" data-frame-line="left"></i>
					</span>
					<div class="identity-rule identity-rule-top" aria-hidden="true">
						<span></span>
						<span></span>
						<span></span>
					</div>
					<div class="identity-columns">
						{
							identityGroups.map((group) => (
								<div class="identity-column">
									{group.names.map((name) =>
										name.primary ? (
											<h1 id="site-title" class={`identity-name ${name.lang} primary-name`}>
												{name.value}
											</h1>
										) : (
											<p class={`identity-name ${name.lang}`}>{name.value}</p>
										),
									)}
								</div>
							))
						}
					</div>
					<div class="identity-rule identity-rule-bottom" aria-hidden="true">
						<span></span>
						<span></span>
						<span></span>
					</div>
				</section>
				<p class="discipline-line">
					<span>Media Art</span><i>/</i><span>Interactive Systems</span><i>/</i>
					<span>Game Engine Research</span><i>/</i><span>Higher Education</span>
				</p>
			</div>
		</section>

		<section class="register-grid" aria-labelledby="identity-title">
			<div class="section-mark">
				<span>01</span>
				<h2 id="identity-title" data-identity-title>Identity Statement</h2>
			</div>
			<div
				id="identity-content"
				class="statement line-frame"
				data-identity-region
				data-reactive-frame
				data-frame-variant="statement"
