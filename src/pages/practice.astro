---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../layouts/Layout.astro';
import { practiceProjects } from '../data/practice.js';

const publicPathExists = (path) => existsSync(join(process.cwd(), 'public', path));
const isPlaceholderVideo = (video) => !video || video.includes('PLACEHOLDER');
const otherWorksNote =
	'These images include student works I supervised during my teaching practice, as well as other exercises and experimental works developed in related contexts.';
---

<Layout>
	<main class="practice-shell">
		<header class="practice-header">
			<a class="home-link" href="/">← home</a>
			<div class="page-title">
				<p>practice archive</p>
				<h1>Practice &amp; Pedagogy</h1>
				<p>
					Selected personal projects, collaborative works, and teaching-generated projects
					outside the main line of my current PhD research.
				</p>
			</div>
		</header>

		<nav class="project-selector" data-project-selector aria-label="Practice project selector">
			{
				practiceProjects.map((project, index) => (
					<button
						type="button"
						class:list={['project-selector-button', index === 0 && 'is-active']}
						data-practice-button={project.id}
						aria-selected={index === 0 ? 'true' : 'false'}
					>
						<span>{String(index + 1).padStart(2, '0')}</span>
						<b>{project.title}</b>
						{project.year && <small>{project.year}</small>}
					</button>
				))
			}
		</nav>

		<section class="practice-stage" aria-live="polite">
			{
				practiceProjects.map((project, index) => (
					<article
						class:list={[
							'practice-panel',
							project.id === 'other-works' && 'practice-panel--archive',
							index === 0 && 'is-active',
						]}
						data-practice-panel={project.id}
						hidden={index !== 0}
					>
						{project.id === 'other-works' ? (
							<div class="archive-wall">
								<div class="student-wall" aria-label={`${project.title} image wall`}>
									{project.images.map((src, imageIndex) =>
										publicPathExists(src) ? (
											<img src={src} alt={`${project.title} documentation ${imageIndex + 1}`} loading="lazy" />
										) : (
											<div class="image-placeholder" aria-label={`Missing image ${imageIndex + 1}`}>
												<span>{String(imageIndex + 1).padStart(2, '0')}</span>
											</div>
										),
									)}
								</div>
								<p class="archive-note">{otherWorksNote}</p>
							</div>
						) : (
							<>
								<div class="media-column">
									{project.displayMode === 'student-wall' ? (
										<div class="student-wall" aria-label={`${project.title} image wall`}>
											{project.images.map((src, imageIndex) =>
												publicPathExists(src) ? (
													<img src={src} alt={`${project.title} documentation ${imageIndex + 1}`} loading="lazy" />
												) : (
													<div class="image-placeholder" aria-label={`Missing image ${imageIndex + 1}`}>
														<span>{String(imageIndex + 1).padStart(2, '0')}</span>
													</div>
												),
											)}
										</div>
									) : project.displayMode === 'video' ? (
										<div class="video-block">
											{isPlaceholderVideo(project.video) ? (
												<p>video documentation forthcoming</p>
											) : (
												<iframe
													src={project.video}
													title={`${project.title} video documentation`}
													loading="lazy"
													allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
													referrerpolicy="strict-origin-when-cross-origin"
													allowfullscreen
												/>
											)}
										</div>
									) : (
										<div class="gallery-grid" aria-label={`${project.title} image gallery`}>
											{project.images.map((src, imageIndex) =>
												publicPathExists(src) ? (
													<img src={src} alt={`${project.title} documentation ${imageIndex + 1}`} loading="lazy" />
												) : (
													<div class="image-placeholder" aria-label={`Missing image ${imageIndex + 1}`}>
														<span>{String(imageIndex + 1).padStart(2, '0')}</span>
													</div>
												),
											)}
										</div>
									)}

								{project.externalLink && !project.externalLink.includes('PLACEHOLDER') && (
									<a class="media-link" href={project.externalLink}>watch video documentation</a>
								)}
								{project.playLink && <a class="media-link" href={project.playLink}>open playable version</a>}
							</div>

							<div class="text-column">
								<header class="project-heading">
									<p>{project.year}</p>
									<h2>{project.title}</h2>
									{project.chineseTitle && <p class="chinese-title">{project.chineseTitle}</p>}
									{project.alternativeTitle && <p class="alternative-title">{project.alternativeTitle}</p>}
								</header>

								<dl class="project-data">
									<div>
										<dt>type</dt>
										<dd>{project.type}</dd>
									</div>
									<div>
										<dt>medium</dt>
										<dd>{project.medium}</dd>
									</div>
									<div>
										<dt>tools</dt>
										<dd>{project.tools.join(', ')}</dd>
									</div>
									<div>
										<dt>keywords</dt>
										<dd>{project.keywords.join(', ')}</dd>
									</div>
									{project.externalLink && !project.externalLink.includes('PLACEHOLDER') && (
										<div>
											<dt>external video link</dt>
											<dd>
												<a href={project.externalLink}>watch video documentation</a>
											</dd>
										</div>
									)}
								</dl>

								<section class="project-copy" aria-label={`${project.title} description`}>
									<div>
										<h3>description</h3>
										<p>{project.description}</p>
									</div>
									<div>
										<h3>artistic relevance</h3>
										<p>{project.artisticRelevance}</p>
									</div>
									<div>
										<h3>research relevance</h3>
										<p>{project.researchRelevance}</p>
									</div>
									{project.credit && (
										<div>
											<h3>credit</h3>
											<p>{project.credit}</p>
										</div>
									)}
									{project.futureNote && (
										<div>
											<h3>future note</h3>
											<p>{project.futureNote}</p>
										</div>
									)}
								</section>
							</div>
						</>
						)}
					</article>
				))
			}
		</section>
	</main>
</Layout>

<script>
	const projectSelector = document.querySelector('[data-project-selector]');
	const practiceButtons = document.querySelectorAll('[data-practice-button]');
	const practicePanels = document.querySelectorAll('[data-practice-panel]');

	for (const button of practiceButtons) {
		button.addEventListener('click', () => {
			const target = button.getAttribute('data-practice-button');

			for (const item of practiceButtons) {
				const isActive = item.getAttribute('data-practice-button') === target;
				item.classList.toggle('is-active', isActive);
				item.setAttribute('aria-selected', String(isActive));
			}

			for (const panel of practicePanels) {
				const isActive = panel.getAttribute('data-practice-panel') === target;
				panel.classList.toggle('is-active', isActive);
				panel.toggleAttribute('hidden', !isActive);
			}

			button.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
		});
	}

	if (projectSelector instanceof HTMLElement) {
		let hasDragged = false;
		let pointerIsDown = false;
		let startX = 0;
		let startScrollLeft = 0;

		projectSelector.addEventListener(
			'wheel',
			(event) => {
				if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
				event.preventDefault();
				projectSelector.scrollLeft += event.deltaY;
			},
			{ passive: false },
		);

		projectSelector.addEventListener('pointerdown', (event) => {
			pointerIsDown = true;
			hasDragged = false;
			startX = event.clientX;
			startScrollLeft = projectSelector.scrollLeft;
		});

		projectSelector.addEventListener('pointermove', (event) => {
			if (!pointerIsDown) return;
			const distance = event.clientX - startX;
			if (Math.abs(distance) < 6 && !hasDragged) return;
			hasDragged = true;
			projectSelector.classList.add('is-dragging');
			projectSelector.scrollLeft = startScrollLeft - (event.clientX - startX);
		});

		const endDrag = () => {
			pointerIsDown = false;
			projectSelector.classList.remove('is-dragging');
		};

		projectSelector.addEventListener('pointerup', endDrag);
		projectSelector.addEventListener('pointercancel', endDrag);
		projectSelector.addEventListener(
			'click',
			(event) => {
				if (!hasDragged) return;
				event.preventDefault();
				event.stopPropagation();
				hasDragged = false;
			},
			true,
		);
	}
</script>

<style>
	:global(body) {
		background: #f5f1e8;
	}

	.practice-shell {
		--paper-local: #f5f1e8;
		--ink-local: #10100d;
		--muted-local: #5f5a51;
		--line-local: #10100d;
		--link-local: #143d31;
		width: min(1180px, calc(100% - 32px));
		min-height: 100vh;
		margin: 0 auto;
		padding: 34px 0 72px;
		color: var(--ink-local);
	}

	.practice-header {
		display: grid;
		grid-template-columns: 86px minmax(0, 1fr);
		column-gap: 28px;
		align-items: start;
		padding: 18px 0 24px;
		border-top: 2px solid var(--line-local);
		border-bottom: 1px solid var(--line-local);
	}

	.home-link,
	.page-title p,
	.project-selector-button,
	.video-block,
	.media-link,
	dt,
	.project-heading p,
	.project-copy h3,
	.image-placeholder {
		font-family: "SFMono-Regular", "Roboto Mono", "Liberation Mono", Consolas, monospace;
		font-size: 10px;
		line-height: 1.35;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	p,
	h1,
	h2,
	h3,
	dl,
	dd {
		margin: 0;
	}

	.home-link,
	.media-link,
	.project-data a {
		color: var(--link-local);
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
	}

	.home-link:hover,
	.home-link:focus-visible,
	.media-link:hover,
	.media-link:focus-visible,
	.project-data a:hover,
	.project-data a:focus-visible {
		color: var(--ink-local);
		outline: none;
	}

	.page-title {
		display: grid;
		gap: 12px;
		max-width: 760px;
	}

	.page-title p {
		max-width: 72ch;
		color: var(--muted-local);
	}

	.page-title h1 {
		font-size: clamp(24px, 3.4vw, 42px);
		font-weight: 400;
		line-height: 1.08;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.project-selector {
		display: flex;
		overflow-x: auto;
		overflow-y: hidden;
		border-bottom: 1px solid var(--line-local);
		scroll-behavior: smooth;
		scroll-snap-type: x proximity;
		-webkit-overflow-scrolling: touch;
		cursor: grab;
	}

	.project-selector.is-dragging {
		cursor: grabbing;
		scroll-snap-type: none;
	}

	.project-selector::-webkit-scrollbar {
		height: 8px;
	}

	.project-selector::-webkit-scrollbar-track {
		background: transparent;
	}

	.project-selector::-webkit-scrollbar-thumb {
		background: var(--line-local);
	}

	.project-selector-button {
		display: grid;
		flex: 0 0 clamp(188px, 23vw, 268px);
		grid-template-rows: auto 1fr auto;
		align-content: start;
		gap: 12px;
		min-height: 132px;
		padding: 14px 14px 15px;
		border: 0;
		border-right: 1px solid var(--line-local);
		border-bottom: 2px solid transparent;
		background: transparent;
		color: var(--link-local);
		text-align: left;
		cursor: pointer;
		scroll-snap-align: start;
	}

	.project-selector-button:last-child {
		border-right: 0;
	}

	.project-selector-button b {
		max-width: 24ch;
		font: inherit;
		line-height: 1.45;
	}

	.project-selector-button small,
	.project-selector-button span {
		color: var(--muted-local);
		font: inherit;
	}

	.project-selector-button:hover,
	.project-selector-button:focus-visible {
		color: var(--ink-local);
		outline: none;
	}

	.project-selector-button.is-active {
		border-bottom-color: var(--line-local);
		color: var(--ink-local);
	}

	.practice-stage {
		padding-top: 34px;
	}

	.practice-panel {
		display: grid;
		grid-template-columns: minmax(0, 1.12fr) minmax(320px, 0.88fr);
		gap: 34px;
	}

	.practice-panel--archive {
		display: block;
	}

	.practice-panel[hidden] {
		display: none;
	}

	.archive-wall {
		width: min(100%, 1080px);
		margin: 0 auto;
	}

	.media-column,
	.text-column {
		min-width: 0;
	}

	.video-block {
		display: grid;
		place-items: center;
		min-height: 260px;
		border-top: 2px solid var(--line-local);
		border-bottom: 1px solid var(--line-local);
		color: var(--muted-local);
	}

	.video-block iframe {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		border: 0;
	}

	.media-link {
		display: inline-block;
		margin-top: 16px;
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 8px;
		padding-bottom: 22px;
		border-bottom: 1px solid var(--line-local);
	}

	.gallery-grid img,
	.image-placeholder {
		width: 100%;
		aspect-ratio: 4 / 3;
		border: 1px solid var(--line-local);
		background: var(--paper-local);
	}

	.gallery-grid img {
		display: block;
		object-fit: cover;
		transition: transform 160ms ease;
	}

	.gallery-grid img:hover {
		transform: scale(1.015);
	}

	.image-placeholder {
		display: grid;
		place-items: center;
		color: var(--muted-local);
	}

	.student-wall {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 8px;
		padding-bottom: 22px;
		border-bottom: 1px solid var(--line-local);
	}

	.student-wall img,
	.student-wall .image-placeholder {
		display: block;
		width: 100%;
		aspect-ratio: 1 / 1;
		border: 1px solid var(--line-local);
		background: var(--paper-local);
		object-fit: cover;
		transition: transform 160ms ease;
	}

	.student-wall img:hover {
		transform: scale(1.04);
	}

	.archive-wall .student-wall {
		padding-bottom: 0;
		border-bottom: 0;
	}

	.archive-note {
		max-width: 88ch;
		margin: 12px 0 0;
		padding-top: 10px;
		border-top: 1px solid var(--line-local);
		color: var(--muted-local);
		font-family: "SFMono-Regular", "Roboto Mono", "Liberation Mono", Consolas, monospace;
		font-size: 11px;
		line-height: 1.55;
	}

	.project-heading {
		display: grid;
		gap: 10px;
		padding-bottom: 22px;
		border-bottom: 2px solid var(--line-local);
	}

	.project-heading p {
		color: var(--muted-local);
	}

	.project-heading h2 {
		max-width: 24ch;
		font-size: clamp(22px, 3vw, 34px);
		font-weight: 400;
		line-height: 1.14;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.project-heading .chinese-title {
		font-family: "Songti SC", "Noto Serif CJK TC", "PMingLiU", "SimSun", serif;
		font-size: 18px;
		line-height: 1.35;
		letter-spacing: 0.08em;
		text-transform: none;
	}

	.project-data {
		display: grid;
		border-bottom: 1px solid var(--line-local);
	}

	.project-data div {
		display: grid;
		grid-template-columns: 92px minmax(0, 1fr);
		gap: 18px;
		padding: 11px 0;
		border-bottom: 1px solid var(--line-local);
	}

	.project-data div:last-child {
		border-bottom: 0;
	}

	dt {
		color: var(--ink-local);
	}

	dd {
		color: var(--muted-local);
		font-size: 14px;
		line-height: 1.55;
	}

	.project-copy {
		display: grid;
		gap: 24px;
		max-width: 58ch;
		padding-top: 26px;
	}

	.project-copy div {
		display: grid;
		gap: 10px;
	}

	.project-copy h3 {
		color: var(--muted-local);
	}

	.project-copy p {
		font-size: clamp(14px, 1.28vw, 16px);
		line-height: 1.76;
		letter-spacing: 0.008em;
	}

	@media (prefers-reduced-motion: reduce) {
		.gallery-grid img,
		.student-wall img {
			transition: none;
		}

		.project-selector {
			scroll-behavior: auto;
		}
	}

	@media (max-width: 1000px) {
		.project-selector-button:nth-child(3n) {
			border-right: 1px solid var(--line-local);
		}
	}

	@media (max-width: 900px) {
		.practice-shell {
			width: min(100% - 24px, 720px);
		}

		.practice-header {
			grid-template-columns: 64px minmax(0, 1fr);
			column-gap: 12px;
		}

		.practice-panel {
			grid-template-columns: 1fr;
			gap: 34px;
		}

		.student-wall {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	@media (max-width: 620px) {
		.practice-header {
			grid-template-columns: 1fr;
			gap: 18px;
		}

		.project-selector-button,
		.project-selector-button:nth-child(3n) {
			min-height: 112px;
			border-right: 1px solid var(--line-local);
		}

		.gallery-grid {
			grid-template-columns: 1fr;
		}

		.student-wall {
			grid-template-columns: repeat(3, 1fr);
			gap: 6px;
		}

		.project-data div {
			grid-template-columns: 1fr;
			gap: 4px;
		}
	}
</style>
