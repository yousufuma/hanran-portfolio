---
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-700.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Portfolio of Hanran Ma: media art, interactive systems, game engine research, higher education, and electronic sound."
		/>
		<title>Hanran Ma</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	:root {
		color-scheme: light;
		background: #f4f0e8;
		color: #11100e;
		font-family: var(--font-sans);
		font-size: 15px;
		line-height: 1.42;
		font-synthesis: none;
		text-rendering: geometricPrecision;
		--font-sans: "IBM Plex Sans Variable", "Helvetica Neue", "Noto Sans", Arial, sans-serif;
		--font-mono: "IBM Plex Mono", "SFMono-Regular", Consolas, monospace;
		--paper: #f4f0e8;
		--ink: #11100e;
		--muted: #686158;
		--rule: #c8c0b5;
		--accent: #4338ca;
		--accent-soft: #ddd8ff;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		background: var(--paper);
		color: var(--ink);
	}

	* {
		box-sizing: border-box;
	}

	a {
		color: inherit;
	}
</style>
